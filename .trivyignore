# False positives - these packages are referenced in devDependencies
# but not actually installed in production builds (npm ci --omit=dev)
CVE-2024-21538  # cross-spawn - devDependency in tinyexec, not installed
CVE-2025-64756  # glob - devDependency reference, not installed
CVE-2026-23745  # tar - devDependency reference, not installed
CVE-2026-23950  # tar - devDependency reference, not installed

# esbuild Go binary vulnerabilities - requires upstream fix from esbuild
# These are in the esbuild binary which we can't control
CVE-2025-58183  # golang stdlib in esbuild
CVE-2025-61729  # golang stdlib in esbuild
