# Site Configuration
SITE_URL=http://localhost:8080
NODE_ENV=development

# Umami Analytics
UMAMI_URL=https://umami.example.com

# Spotify Integration (optional)
# To enable real Spotify data:
# 1. Open your Spotify Developer app at https://developer.spotify.com/dashboard
# 2. Add http://127.0.0.1:3000/callback as a redirect URI (not localhost!)
# 3. Run: SPOTIFY_CLIENT_ID=xxx SPOTIFY_CLIENT_SECRET=xxx node scripts/spotify-auth.js
# 4. Follow the prompts to get your refresh token
# 5. Set USE_MOCK_DATA = false in src/pages/api/spotify/now-playing.ts
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
