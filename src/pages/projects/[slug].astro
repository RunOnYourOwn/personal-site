---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead
      title={`${project.data.title} - Projects`}
      description={project.data.description}
    />
  </head>
  <body>
    <Header />
    <main class="content">
      <article>
        <header class="project-header">
          <div class="project-meta">
            {project.data.year && <span>{project.data.year}</span>}
            {project.data.year && project.data.status && <span>·</span>}
            {
              project.data.status && (
                <span class="status">
                  {project.data.status.replace('-', ' ')}
                </span>
              )
            }
          </div>
          <h1>{project.data.title}</h1>
          <p class="description">{project.data.description}</p>

          {
            (project.data.link || project.data.repo) && (
              <div class="project-links">
                {project.data.link && (
                  <a
                    href={project.data.link}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    View Site
                  </a>
                )}
                {project.data.repo && (
                  <a
                    href={project.data.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Repository
                  </a>
                )}
              </div>
            )
          }
        </header>

        {
          project.data.heroImage && (
            <div class="hero-image">
              <Image
                src={project.data.heroImage}
                alt={`${project.data.title}`}
                width={720}
                height={360}
              />
            </div>
          )
        }

        <div class="prose">
          <Content />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  .content {
    max-width: 640px;
    margin: 0 auto;
    padding: 6rem 1.5rem 4rem;
    overflow-x: hidden;
  }

  .project-header {
    margin-bottom: 2.5rem;
  }

  .project-meta {
    display: flex;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .status {
    text-transform: capitalize;
  }

  .project-header h1 {
    font-size: 1.875rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0 0 0.75rem 0;
    line-height: 1.3;
  }

  .description {
    font-size: 1rem;
    color: var(--text-secondary);
    margin: 0 0 1.5rem 0;
    line-height: 1.6;
  }

  .project-links {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .project-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.15s ease;
  }

  .project-links a:hover {
    color: var(--accent);
  }

  .hero-image {
    margin-bottom: 2.5rem;
  }

  .hero-image img {
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .prose {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.7;
  }

  .prose :global(p) {
    margin-bottom: 1.5rem;
  }

  .prose :global(h2) {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 2.5rem 0 1rem 0;
    letter-spacing: -0.01em;
  }

  .prose :global(h3) {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 2rem 0 0.75rem 0;
  }

  .prose :global(h4) {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 1.5rem 0 0.5rem 0;
  }

  .prose :global(a) {
    color: var(--text-secondary);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s ease;
  }

  .prose :global(a:hover) {
    color: var(--accent);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--border);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--text-muted);
    font-style: italic;
  }

  .prose :global(code) {
    background: var(--bg-secondary);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    font-size: 0.875em;
  }

  .prose :global(pre) {
    background: var(--bg-secondary);
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1.5rem 0;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .content {
      padding: 5rem 1rem 3rem;
    }

    .project-header h1 {
      font-size: 1.5rem;
    }
  }
</style>
