---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FormattedDate from '../components/FormattedDate.astro';
import StructuredData from '../components/StructuredData.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../consts';

// Get latest blog posts and projects
const allBlogPosts = await getCollection('blog');
const allProjects = await getCollection('projects');

// Sort blog posts by date and get the latest 5
const latestPosts = allBlogPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 5);

// Get featured or recent projects
const featuredProjects = allProjects
  .filter(project => project.data.featured)
  .slice(0, 4);
---

<BaseLayout
  title={SITE_TITLE}
  description="Data scientist at BP recently doing more forward deployed engineering work. Building ML systems, tinkering with homelabs, and occasionally writing about it."
>
  <StructuredData type="website" data={{}} />
  <Hero />

  <main class="content">
    <section class="section">
      <h2 class="section-title">Writing</h2>
      {
        latestPosts.length > 0 ? (
          <ul class="post-list">
            {latestPosts.map(post => (
              <li class="post-item">
                <a href={`/blog/${post.slug}`} class="post-link">
                  <span class="post-title">{post.data.title}</span>
                  <span class="post-date">
                    <FormattedDate date={post.data.pubDate} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty-message">No posts yet.</p>
        )
      }
      <a href="/blog" class="view-all">All posts →</a>
    </section>

    <section class="section">
      <h2 class="section-title">Projects</h2>
      {
        featuredProjects.length > 0 ? (
          <ul class="project-list">
            {featuredProjects.map(project => (
              <li class="project-item">
                <a
                  href={project.data.link || `/projects/${project.slug}`}
                  class="project-link"
                  target={project.data.link ? '_blank' : undefined}
                  rel={project.data.link ? 'noopener' : undefined}
                >
                  <span class="project-title">{project.data.title}</span>
                  <span class="project-description">
                    {project.data.description}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty-message">No projects yet.</p>
        )
      }
      <a href="/projects" class="view-all">All projects →</a>
    </section>
  </main>
</BaseLayout>

<style>
  .content {
    max-width: 640px;
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
  }

  .section {
    margin-bottom: 3rem;
  }

  .section-title {
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin: 0 0 1rem 0;
  }

  /* Post list styles */
  .post-list,
  .project-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem 0;
  }

  .post-item,
  .project-item {
    border-bottom: 1px solid var(--border);
  }

  .post-item:last-child,
  .project-item:last-child {
    border-bottom: none;
  }

  .post-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.75rem 0;
    text-decoration: none;
  }

  .post-link:hover .post-title {
    color: var(--accent);
  }

  .post-title {
    color: var(--text-secondary);
    font-weight: 500;
    font-size: 1rem;
    line-height: 1.4;
    transition: color 0.15s ease;
  }

  .post-date {
    color: var(--text-muted);
    font-size: 0.875rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Project list styles */
  .project-link {
    display: block;
    padding: 0.75rem 0;
    text-decoration: none;
  }

  .project-link:hover .project-title {
    color: var(--accent);
  }

  .project-title {
    display: block;
    color: var(--text-secondary);
    font-weight: 500;
    font-size: 1rem;
    margin-bottom: 0.25rem;
    transition: color 0.15s ease;
  }

  .project-description {
    display: block;
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .view-all {
    display: inline-block;
    color: var(--text-muted);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .view-all:hover {
    color: var(--accent);
  }

  .empty-message {
    color: var(--text-muted);
    font-size: 0.9375rem;
    margin: 0 0 1rem 0;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .content {
      padding: 0 1rem 3rem;
    }

    .post-link {
      flex-direction: column;
      gap: 0.25rem;
    }

    .post-date {
      font-size: 0.8125rem;
    }
  }
</style>
