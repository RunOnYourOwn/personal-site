---
import HeaderLink from './HeaderLink.astro';
import DarkModeToggle from './DarkModeToggle.astro';
---

<header role="banner">
  <nav
    id="site-navigation"
    role="navigation"
    aria-label="Main navigation"
    tabindex="-1"
  >
    <a href="/" class="site-name">Aaron Brazier</a>
    <div class="nav-links" role="menubar">
      <HeaderLink href="/blog">Blog</HeaderLink>
      <HeaderLink href="/projects">Projects</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
      <DarkModeToggle />
    </div>
  </nav>
</header>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border);
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 640px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 56px;
  }

  .site-name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .site-name:hover {
    color: var(--accent);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-links :global(a) {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
    padding: 0;
    border: none;
  }

  .nav-links :global(a:hover),
  .nav-links :global(a.active) {
    color: var(--text-primary);
  }

  /* Dark mode */
  :global(.dark) header {
    background: var(--bg-primary);
    border-color: var(--border);
  }

  :global(.dark) .site-name {
    color: var(--text-primary);
  }

  :global(.dark) .nav-links :global(a) {
    color: var(--text-muted);
  }

  :global(.dark) .nav-links :global(a:hover),
  :global(.dark) .nav-links :global(a.active) {
    color: var(--text-primary);
  }

  /* Responsive */
  @media (max-width: 640px) {
    nav {
      padding: 0 1rem;
    }

    .nav-links {
      gap: 1rem;
    }

    .nav-links :global(a) {
      font-size: 0.8125rem;
    }
  }
</style>
