---
import HeaderLink from './HeaderLink.astro';
import DarkModeToggle from './DarkModeToggle.astro';
---

<header role="banner">
  <nav
    id="site-navigation"
    role="navigation"
    aria-label="Main navigation"
    tabindex="-1"
  >
    <a href="/" class="site-name">Aaron Brazier</a>
    <div class="now-playing" id="now-playing"></div>
    <div class="nav-links" role="menubar">
      <HeaderLink href="/blog">Blog</HeaderLink>
      <HeaderLink href="/projects">Projects</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
      <DarkModeToggle />
    </div>
  </nav>
</header>

<script>
  async function fetchNowPlaying() {
    try {
      const response = await fetch('/api/spotify/now-playing');
      if (!response.ok) return;

      const data = await response.json();
      const container = document.getElementById('now-playing');
      if (!container) return;

      if (!data.title) {
        container.innerHTML = '';
        return;
      }

      const icon = data.isPlaying
        ? `<span class="now-playing-icon">
            <span class="now-playing-bar"></span>
            <span class="now-playing-bar"></span>
            <span class="now-playing-bar"></span>
          </span>`
        : `<svg class="now-playing-icon-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polygon points="10 8 16 12 10 16 10 8"></polygon>
          </svg>`;

      container.innerHTML = `
        <a href="${data.songUrl}" target="_blank" rel="noopener" class="now-playing-link">
          ${icon}
          <span class="now-playing-track-wrapper">
            <span class="now-playing-track">${data.title} – ${data.artist}</span>
          </span>
        </a>
      `;

      // Check if text overflows and needs scrolling
      const track = container.querySelector('.now-playing-track');
      const wrapper = container.querySelector('.now-playing-track-wrapper');
      if (track && wrapper && track.scrollWidth > wrapper.clientWidth) {
        track.classList.add('scrolling');
      }
    } catch {
      // Silently fail - widget is optional
    }
  }

  fetchNowPlaying();
  setInterval(fetchNowPlaying, 30000);
</script>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border);
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 640px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 56px;
  }

  .site-name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .site-name:hover {
    color: var(--accent);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-links :global(a) {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
    padding: 0;
    border: none;
  }

  .nav-links :global(a:hover),
  .nav-links :global(a.active) {
    color: var(--text-primary);
  }

  /* Now Playing in header */
  .now-playing {
    flex: 1;
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  .now-playing:empty {
    display: none;
  }

  :global(.now-playing-link) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
    max-width: 200px;
  }

  :global(.now-playing-track-wrapper) {
    overflow: hidden;
    flex: 1;
    min-width: 0;
  }

  :global(.now-playing-link:hover) {
    color: var(--text-secondary);
  }

  :global(.now-playing-icon) {
    display: flex;
    align-items: center;
    gap: 1px;
    flex-shrink: 0;
  }

  :global(.now-playing-icon-svg) {
    flex-shrink: 0;
    opacity: 0.7;
  }

  :global(.now-playing-bar) {
    width: 2px;
    height: 10px;
    background: #1db954;
    border-radius: 1px;
    animation: sound 0.5s ease-in-out infinite alternate;
  }

  :global(.now-playing-bar:nth-child(2)) {
    animation-delay: 0.2s;
  }

  :global(.now-playing-bar:nth-child(3)) {
    animation-delay: 0.4s;
  }

  @keyframes sound {
    0% {
      height: 3px;
    }
    100% {
      height: 10px;
    }
  }

  :global(.now-playing-track) {
    display: inline-block;
    white-space: nowrap;
    animation: marquee 12s linear infinite;
    animation-play-state: paused;
  }

  :global(.now-playing-link:hover .now-playing-track) {
    animation-play-state: running;
  }

  /* Auto-scroll for overflowing text */
  :global(.now-playing-track.scrolling) {
    animation-play-state: running;
  }

  @keyframes marquee {
    0%,
    10% {
      transform: translateX(0);
    }
    45%,
    55% {
      transform: translateX(calc(-100% + 180px));
    }
    90%,
    100% {
      transform: translateX(0);
    }
  }

  /* Dark mode */
  :global(.dark) header {
    background: var(--bg-primary);
    border-color: var(--border);
  }

  :global(.dark) .site-name {
    color: var(--text-primary);
  }

  :global(.dark) .nav-links :global(a) {
    color: var(--text-muted);
  }

  :global(.dark) .nav-links :global(a:hover),
  :global(.dark) .nav-links :global(a.active) {
    color: var(--text-primary);
  }

  /* Responsive */
  @media (max-width: 640px) {
    nav {
      padding: 0 1rem;
    }

    .now-playing {
      display: none;
    }

    .nav-links {
      gap: 1rem;
    }

    .nav-links :global(a) {
      font-size: 0.8125rem;
    }
  }
</style>
