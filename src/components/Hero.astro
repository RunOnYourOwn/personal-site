---
// Minimal Hero/Intro component inspired by leerob.com and shuding.me
---

<section class="intro">
  <div class="intro-content">
    <div class="intro-bio">
      <p>
        I'm a data scientist at BP, recently doing more forward deployed
        engineering work. Building ML systems, tinkering with homelabs, and
        occasionally writing about it.
      </p>
    </div>

    <div class="intro-links">
      <a href="https://github.com/RunOnYourOwn" target="_blank" rel="noopener">
        GitHub
      </a>
      <a
        href="https://linkedin.com/in/aaronbrazier"
        target="_blank"
        rel="noopener"
      >
        LinkedIn
      </a>
      <a href="mailto:aaron@aaronbrazier.com">Email</a>
      <a href="/blog">Blog</a>
    </div>

    <div class="now-playing" id="now-playing">
      <!-- Spotify now playing will be populated via JS -->
    </div>
  </div>
</section>

<style>
  .intro {
    max-width: 640px;
    margin: 0 auto;
    padding: 6rem 1.5rem 2rem;
  }

  .intro-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .intro-bio {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .intro-bio p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin: 0;
  }

  .intro-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 0.5rem;
  }

  .intro-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    transition: color 0.15s ease;
    position: relative;
  }

  .intro-links a:hover {
    color: var(--accent);
  }

  .intro-links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 0;
    height: 1px;
    background: var(--accent);
    transition: width 0.2s ease;
  }

  .intro-links a:hover::after {
    width: 100%;
  }

  /* Now Playing placeholder */
  .now-playing {
    margin-top: 0.5rem;
    min-height: 2rem;
  }

  .now-playing:empty {
    display: none;
  }

  .now-playing-content {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .now-playing-icon {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .now-playing-bar {
    width: 3px;
    height: 12px;
    background: #1db954;
    border-radius: 1px;
    animation: sound 0.5s ease-in-out infinite alternate;
  }

  .now-playing-bar:nth-child(2) {
    animation-delay: 0.2s;
  }

  .now-playing-bar:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes sound {
    0% {
      height: 4px;
    }
    100% {
      height: 12px;
    }
  }

  .now-playing-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .now-playing-text a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .now-playing-text a:hover {
    color: var(--accent);
  }

  /* Dark mode */
  :global(.dark) .intro-bio p {
    color: var(--text-secondary);
  }

  /* Responsive */
  @media (max-width: 640px) {
    .intro {
      padding: 5rem 1rem 1.5rem;
    }

    .intro-bio p {
      font-size: 1rem;
    }

    .intro-links {
      gap: 1rem;
    }
  }
</style>
